@model Nop.Plugin.Misc.Alanube.Models.CompaniesModel

@{
    Layout = "_ConfigurePlugin";
}

<div class="content-header clearfix">
    <h1 class="float-left">@T("Plugins.Misc.Alanube.AdminMenu.Companies")</h1>
    <div class="float-right"><a asp-controller="AlanubeAdmin" asp-action="CreateCompany" class="btn btn-primary">@T("Admin.Common.AddNewRecord")</a></div>
</div>

<div class="content">
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    else if (!Model.Companies.Any())
    {
        <div class="alert alert-info">@T("Plugins.Misc.Alanube.Companies.Empty")</div>
    }
    else
    {
        <div class="card card-default">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover table-bordered">
                        <thead>
                            <tr>
                                <th>@T("Plugins.Misc.Alanube.Companies.Id")</th>
                                <th>@T("Plugins.Misc.Alanube.Companies.Ruc")</th>
                                <th>@T("Plugins.Misc.Alanube.Companies.TradeName")</th>
                                <th>@T("Plugins.Misc.Alanube.Companies.Status")</th>
                                <th>@T("Plugins.Misc.Alanube.Companies.Type")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var company in Model.Companies)
                            {
                                <tr>
                                    <td>@company.Id</td>
                                    <td>@company.Ruc</td>
                                    <td>@company.TradeName</td>
                                    <td>@company.Affiliated</td>
                                    <td>@company.Type</td>
                                    <td><a asp-controller="AlanubeAdmin" asp-action="EditCompany" asp-route-id="@company.Id">@T("Admin.Common.Edit")</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
