@using Nop.Plugin.Misc.Alanube.Configuration
@model Nop.Plugin.Misc.Alanube.Models.ConfigurationModel

@{
    Layout = "_ConfigurePlugin";

    var companies = Model?.Companies;
    var offices = Model?.Offices;

    var testConnectionSucceeded = Model?.TestConnectionSucceeded;
    var testConnectionMessage = Model?.TestConnectionMessage ?? string.Empty;
    var testConnectionEnvironment = Model?.TestConnectionEnvironment ?? string.Empty;
    var testConnectionStatusCode = Model?.TestConnectionStatusCode;
    var testConnectionErrorCode = Model?.TestConnectionErrorCode ?? string.Empty;
    var companiesLoadError = Model?.CompaniesLoadError ?? string.Empty;
}

<form asp-controller="AlanubeAdmin"
      asp-action="Configure"
      method="post"
      id="alanube-config-form">

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="cards-group">
        <div class="card card-default">
            <div class="card-body">

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="Enabled" />
                    </div>

                    <div class="col-md-9">
                        <nop-editor asp-for="Enabled" />
                        <span asp-validation-for="Enabled"
                              class="text-danger"></span>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(companiesLoadError))
                {
                    <div class="form-group row">
                        <div class="col-md-9 offset-md-3">
                            <div class="alert alert-warning">@companiesLoadError</div>
                        </div>
                    </div>
                }

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="InvoiceTrigger" />
                    </div>
                    <div class="col-md-9">
                        <nop-select asp-for="InvoiceTrigger"
                                    asp-items="Html.GetEnumSelectList<InvoiceTrigger>()" />
                        <span asp-validation-for="InvoiceTrigger" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-3">
                        <nop-label asp-for="EnableWebhook" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="EnableWebhook" />
                        <span asp-validation-for="EnableWebhook" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row" id="webhook-secret-row">
                    <div class="col-md-3">
                        <nop-label asp-for="WebhookSecret" />
                    </div>
                    <div class="col-md-9">
                        <nop-editor asp-for="WebhookSecret"
                                    html-attributes="@(new { autocomplete = "new-password" })" />
                        <span asp-validation-for="WebhookSecret" class="text-danger"></span>
                        <span class="form-text">Configure this same value in Alanube as the X-Alanube-Webhook-Key header.</span>
                    </div>
                </div>

                <div class="card card-default mt-3">
                    <div class="card-header">Configuración fiscal de facturas</div>
                    <div class="card-body">
                        <p class="text-muted">La numeración es fiscal e independiente de los pedidos de nopCommerce. El próximo número solo inicializa una serie nueva; una serie ya usada no se reinicia desde esta pantalla.</p>
                        <div class="form-group row"><div class="col-md-3"><nop-label asp-for="BillingPoint" /></div><div class="col-md-9"><nop-editor asp-for="BillingPoint" /><span asp-validation-for="BillingPoint" class="text-danger"></span></div></div>
                        <div class="form-group row"><div class="col-md-3"><nop-label asp-for="NextFiscalNumber" /></div><div class="col-md-9"><nop-editor asp-for="NextFiscalNumber" /><span asp-validation-for="NextFiscalNumber" class="text-danger"></span></div></div>
                        <div class="form-group row"><div class="col-md-3"><nop-label asp-for="IssueType" /></div><div class="col-md-9"><select asp-for="IssueType" class="form-control"><option value="01">01 — Normal previa</option><option value="02">02 — Contingencia previa</option><option value="03">03 — Normal posterior</option><option value="04">04 — Contingencia posterior</option></select></div></div>
                        <div class="form-group row"><div class="col-md-3"><nop-label asp-for="DocumentType" /></div><div class="col-md-9"><select asp-for="DocumentType" class="form-control"><option value="01">01 — Factura interna</option><option value="02">02 — Importación</option><option value="03">03 — Exportación</option><option value="08">08 — Zona franca</option><option value="09">09 — Reembolso</option></select></div></div>
                        <div class="form-group row"><div class="col-md-3"><nop-label asp-for="Nature" /></div><div class="col-md-9"><nop-editor asp-for="Nature" /><span asp-validation-for="Nature" class="text-danger"></span></div></div>
                        <div class="form-group row"><div class="col-md-3"><nop-label asp-for="OperationType" /></div><div class="col-md-9"><select asp-for="OperationType" class="form-control"><option value="1">1 — Salida o venta</option><option value="2">2 — Entrada o compra</option></select></div></div>
                        <div class="form-group row"><div class="col-md-3"><nop-label asp-for="Destination" /></div><div class="col-md-9"><select asp-for="Destination" class="form-control"><option value="1">1 — Panamá</option><option value="2">2 — Extranjero</option></select></div></div>
                        <div class="form-group row"><div class="col-md-3"><nop-label asp-for="ReceiverContainer" /></div><div class="col-md-9"><select asp-for="ReceiverContainer" class="form-control"><option value="1">1 — Normal</option><option value="2">2 — Exento de contenedor</option></select></div></div>
                        <div class="form-group row"><div class="col-md-3"><nop-label asp-for="CafeFormat" /></div><div class="col-md-9"><select asp-for="CafeFormat" class="form-control"><option value="1">1 — Sin CAFE</option><option value="2">2 — Cinta</option><option value="3">3 — Carta</option></select></div></div>
                        <div class="form-group row"><div class="col-md-3"><nop-label asp-for="CafeDelivery" /></div><div class="col-md-9"><select asp-for="CafeDelivery" class="form-control"><option value="1">1 — Sin CAFE</option><option value="2">2 — Papel</option><option value="3">3 — Electrónico</option></select></div></div>
                        <div class="form-group row"><div class="col-md-3"><nop-label asp-for="SaleType" /></div><div class="col-md-9"><select asp-for="SaleType" class="form-control"><option value="1">1 — Giro normal</option><option value="2">2 — Activo fijo</option><option value="3">3 — Bienes raíces</option><option value="4">4 — Servicios</option></select></div></div>
                    </div>
                </div>

                <div class="form-group row">
                    <div class="col-md-9 offset-md-3">
                        <button type="submit"
                                name="test-connection"
                                value="true"
                                class="btn bg-blue"
                                formnovalidate>
                            Probar conexión
                        </button>
                    </div>
                </div>

                @if (testConnectionSucceeded.HasValue)
                {
                    <div class="form-group row">
                        <div class="col-md-9 offset-md-3">

                            <div class="alert @(testConnectionSucceeded.Value ? "alert-success" : "alert-danger")">

                                <strong>
                                    Resultado de conexión
                                </strong>

                                @if (!string.IsNullOrWhiteSpace(testConnectionMessage))
                                {
                                    <br />
                                    @testConnectionMessage
                                }

                                @if (!string.IsNullOrWhiteSpace(testConnectionEnvironment))
                                {
                                    <br />
                                    <span>
                                        Ambiente:
                                        @testConnectionEnvironment
                                    </span>
                                }

                                @if (testConnectionStatusCode.HasValue)
                                {
                                    <br />
                                    <span>
                                        Estado:
                                        @testConnectionStatusCode.Value
                                    </span>
                                }

                                @if (!string.IsNullOrWhiteSpace(testConnectionErrorCode))
                                {
                                    <br />
                                    <span>
                                        Código de error:
                                        @testConnectionErrorCode
                                    </span>
                                }

                            </div>

                        </div>
                    </div>
                }

                <div class="form-group row">

                    <div class="col-md-3">
                        <nop-label asp-for="CompanyId" />
                    </div>

                    <div class="col-md-9">

                        <select asp-for="CompanyId"
                                class="form-control"
                                id="CompanyId">

                            <option value="">
                                Seleccione una compañía
                            </option>

                            @if (companies != null)
                            {
                                foreach (var company in companies)
                                {
                                    if (company == null)
                                    {
                                        continue;
                                    }

                                    var companyId = company.Id?.ToString() ?? string.Empty;
                                    var tradeName = company.TradeName?.ToString() ?? string.Empty;
                                    var ruc = company.Ruc?.ToString() ?? string.Empty;

                                    if (string.IsNullOrWhiteSpace(companyId))
                                    {
                                        continue;
                                    }

                                    var companyDisplayName = companyId;

                                    if (!string.IsNullOrWhiteSpace(tradeName) &&
                                        !string.IsNullOrWhiteSpace(ruc))
                                    {
                                        companyDisplayName = $"{tradeName} ({ruc})";
                                    }
                                    else if (!string.IsNullOrWhiteSpace(tradeName))
                                    {
                                        companyDisplayName = tradeName;
                                    }
                                    else if (!string.IsNullOrWhiteSpace(ruc))
                                    {
                                        companyDisplayName = ruc;
                                    }

                                    <option value="@companyId">
                                        @companyDisplayName
                                    </option>
                                }
                            }

                        </select>

                        <span asp-validation-for="CompanyId"
                              class="text-danger"></span>

                        <span id="CompanyIdValidation"
                              class="text-danger"
                              style="display:none;">
                            Debe seleccionar una compañía.
                        </span>

                    </div>
                </div>

                <div class="form-group row">

                    <div class="col-md-3">
                        <nop-label asp-for="OfficeId" />
                    </div>

                    <div class="col-md-9">

                        <select asp-for="OfficeId"
                                class="form-control"
                                id="OfficeId">

                            <option value="">
                                Seleccione una oficina
                            </option>

                            @if (offices != null)
                            {
                                foreach (var office in offices)
                                {
                                    if (office == null)
                                    {
                                        continue;
                                    }

                                    var officeId = office.Id?.ToString() ?? string.Empty;
                                    var code = office.Code?.ToString() ?? string.Empty;
                                    var address = office.Address?.ToString() ?? string.Empty;

                                    if (string.IsNullOrWhiteSpace(officeId))
                                    {
                                        continue;
                                    }

                                    var officeDisplayName = officeId;

                                    if (!string.IsNullOrWhiteSpace(code) &&
                                        !string.IsNullOrWhiteSpace(address))
                                    {
                                        officeDisplayName = $"{code} - {address}";
                                    }
                                    else if (!string.IsNullOrWhiteSpace(code))
                                    {
                                        officeDisplayName = code;
                                    }
                                    else if (!string.IsNullOrWhiteSpace(address))
                                    {
                                        officeDisplayName = address;
                                    }

                                    <option value="@officeId">
                                        @officeDisplayName
                                    </option>
                                }
                            }

                        </select>

                        <span asp-validation-for="OfficeId"
                              class="text-danger"></span>

                        <span id="OfficeIdValidation"
                              class="text-danger"
                              style="display:none;">
                            Debe seleccionar una oficina.
                        </span>

                    </div>
                </div>

                <div class="form-group row">

                    <div class="col-md-3">
                        <nop-label asp-for="Environment" />
                    </div>

                    <div class="col-md-9">

                        <nop-select asp-for="Environment"
                                    asp-items="Html.GetEnumSelectList<AlanubeEnvironment>()" />

                        <span asp-validation-for="Environment"
                              class="text-danger"></span>

                        <span id="EnvironmentValidation"
                              class="text-danger"
                              style="display:none;">
                            Debe seleccionar un ambiente válido.
                        </span>

                    </div>
                </div>

                <div class="form-group row">

                    <div class="col-md-3">
                        <nop-label asp-for="SandboxApiToken" />
                    </div>

                    <div class="col-md-9">

                        <nop-editor asp-for="SandboxApiToken"
                                    html-attributes="@(new
                                    {
                                        autocomplete = "new-password"
                                    })" />

                        <span asp-validation-for="SandboxApiToken"
                              class="text-danger"></span>

                        <span id="SandboxApiTokenValidation"
                              class="text-danger"
                              style="display:none;">
                            Debe especificar el API Token de Sandbox.
                        </span>

                    </div>
                </div>

                <div class="form-group row">

                    <div class="col-md-3">
                        <nop-label asp-for="ProductionApiToken" />
                    </div>

                    <div class="col-md-9">

                        <nop-editor asp-for="ProductionApiToken"
                                    html-attributes="@(new
                                    {
                                        autocomplete = "new-password"
                                    })" />

                        <span asp-validation-for="ProductionApiToken"
                              class="text-danger"></span>

                        <span id="ProductionApiTokenValidation"
                              class="text-danger"
                              style="display:none;">
                            Debe especificar el API Token de producción.
                        </span>

                    </div>
                </div>

                <div class="form-group row">

                    <div class="col-md-9 offset-md-3">

                        <button type="submit"
                                class="btn btn-primary"
                                id="save-configuration">
                            Guardar
                        </button>

                    </div>
                </div>

            </div>
        </div>
    </div>

</form>

<script asp-location="Footer">

    $(document).ready(function () {

        var $form = $('#alanube-config-form');

        function getValue(selector) {

            var $element = $(selector);

            if (!$element.length) {
                return '';
            }

            var value = $element.val();

            if (value === null ||
                value === undefined) {
                return '';
            }

            return value.toString().trim();
        }

        function getEnabled() {

            var $enabled = $('#Enabled');

            if (!$enabled.length) {
                return false;
            }

            if ($enabled.is(':checkbox')) {
                return $enabled.is(':checked');
            }

            var value = $enabled.val();

            if (value === null ||
                value === undefined) {
                return false;
            }

            value = value
                .toString()
                .trim()
                .toLowerCase();

            return value === 'true' ||
                   value === '1' ||
                   value === 'on';
        }

        function updateWebhookSecretVisibility() {
            var $enabled = $('#EnableWebhook');
            var isEnabled = $enabled.is(':checkbox') ? $enabled.is(':checked') : $enabled.val() === 'true';
            $('#webhook-secret-row').toggle(isEnabled);
        }

        function loadOffices(companyId) {
            var $office = $('#OfficeId');
            $office.empty().append($('<option>', { value: '', text: 'Seleccione una oficina' }));

            if (!companyId) {
                return;
            }

            $.getJSON('/Admin/Alanube/Companies/' + encodeURIComponent(companyId) + '/Offices')
                .done(function (offices) {
                    $.each(offices, function (_, office) {
                        $office.append($('<option>', { value: office.id, text: office.label }));
                    });
                })
                .fail(function () {
                    $office.append($('<option>', { value: '', text: 'No se pudieron cargar las oficinas' }));
                });
        }

        function hideValidationMessages() {

            $('#CompanyIdValidation').hide();
            $('#OfficeIdValidation').hide();
            $('#EnvironmentValidation').hide();
            $('#SandboxApiTokenValidation').hide();
            $('#ProductionApiTokenValidation').hide();

            $('#CompanyId')
                .removeClass('input-validation-error');

            $('#OfficeId')
                .removeClass('input-validation-error');

            $('#Environment')
                .removeClass('input-validation-error');

            $('#SandboxApiToken')
                .removeClass('input-validation-error');

            $('#ProductionApiToken')
                .removeClass('input-validation-error');
        }

        function showValidation(
            selector,
            validationSelector) {

            $(selector)
                .addClass('input-validation-error');

            $(validationSelector)
                .show();
        }

        function getEnvironmentText() {

            var $environment = $('#Environment');

            if (!$environment.length) {
                return '';
            }

            var selectedText = $environment
                .find('option:selected')
                .text();

            if (selectedText === null ||
                selectedText === undefined) {
                return '';
            }

            return selectedText
                .toString()
                .trim()
                .toLowerCase();
        }

        function validateConfiguration() {

            hideValidationMessages();

            if (!getEnabled()) {
                return true;
            }

            var isValid = true;

            var companyId =
                getValue('#CompanyId');

            var officeId =
                getValue('#OfficeId');

            var environment =
                getValue('#Environment');

            var sandboxToken =
                getValue('#SandboxApiToken');

            var productionToken =
                getValue('#ProductionApiToken');

            if (!companyId) {

                showValidation(
                    '#CompanyId',
                    '#CompanyIdValidation'
                );

                isValid = false;
            }

            if (!officeId) {

                showValidation(
                    '#OfficeId',
                    '#OfficeIdValidation'
                );

                isValid = false;
            }

            if (!environment) {

                showValidation(
                    '#Environment',
                    '#EnvironmentValidation'
                );

                isValid = false;
            }

            var environmentText =
                getEnvironmentText();

            var isSandbox =
                environmentText.indexOf('sandbox') !== -1;

            var isProduction =
                environmentText.indexOf('production') !== -1 ||
                environmentText.indexOf('producción') !== -1 ||
                environmentText.indexOf('produccion') !== -1;

            if (isSandbox &&
                !sandboxToken) {

                showValidation(
                    '#SandboxApiToken',
                    '#SandboxApiTokenValidation'
                );

                isValid = false;
            }

            if (isProduction &&
                !productionToken) {

                showValidation(
                    '#ProductionApiToken',
                    '#ProductionApiTokenValidation'
                );

                isValid = false;
            }

            return isValid;
        }

        $form.on(
            'submit',
            function (event) {

                var submitter = null;

                if (event.originalEvent &&
                    event.originalEvent.submitter) {

                    submitter =
                        event.originalEvent.submitter;
                }

                if (submitter) {

                    var submitterName =
                        $(submitter).attr('name');

                    if (submitterName ===
                        'test-connection') {

                        return true;
                    }
                }

                if (!validateConfiguration()) {

                    event.preventDefault();
                    event.stopImmediatePropagation();

                    var $firstError =
                        $('.input-validation-error')
                            .first();

                    if ($firstError.length) {
                        $firstError.trigger('focus');
                    }

                    return false;
                }

                return true;
            }
        );

        $('#CompanyId')
            .on(
                'change',
                function () {

                    if (getValue('#CompanyId')) {

                        $('#CompanyIdValidation')
                            .hide();

                        $('#CompanyId')
                            .removeClass(
                                'input-validation-error'
                            );
                    }

                    loadOffices(getValue('#CompanyId'));
                }
            );

        $('#EnableWebhook').on('change', updateWebhookSecretVisibility);
        updateWebhookSecretVisibility();

        $('#OfficeId')
            .on(
                'change',
                function () {

                    if (getValue('#OfficeId')) {

                        $('#OfficeIdValidation')
                            .hide();

                        $('#OfficeId')
                            .removeClass(
                                'input-validation-error'
                            );
                    }
                }
            );

        $('#Environment')
            .on(
                'change',
                function () {

                    $('#EnvironmentValidation')
                        .hide();

                    $('#Environment')
                        .removeClass(
                            'input-validation-error'
                        );

                    $('#SandboxApiTokenValidation')
                        .hide();

                    $('#ProductionApiTokenValidation')
                        .hide();

                    $('#SandboxApiToken')
                        .removeClass(
                            'input-validation-error'
                        );

                    $('#ProductionApiToken')
                        .removeClass(
                            'input-validation-error'
                        );
                }
            );

        $('#SandboxApiToken')
            .on(
                'input change',
                function () {

                    if (getValue('#SandboxApiToken')) {

                        $('#SandboxApiTokenValidation')
                            .hide();

                        $('#SandboxApiToken')
                            .removeClass(
                                'input-validation-error'
                            );
                    }
                }
            );

        $('#ProductionApiToken')
            .on(
                'input change',
                function () {

                    if (getValue('#ProductionApiToken')) {

                        $('#ProductionApiTokenValidation')
                            .hide();

                        $('#ProductionApiToken')
                            .removeClass(
                                'input-validation-error'
                            );
                    }
                }
            );

    });

</script>
