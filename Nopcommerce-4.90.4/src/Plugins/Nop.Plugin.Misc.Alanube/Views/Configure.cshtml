@model Nop.Plugin.Misc.Alanube.Models.ConfigurationModel

@{
    Layout = "_ConfigurePlugin";
}

<form asp-controller="AlanubeAdmin" asp-action="Configure" method="post">
    <div class="cards-group">
        <div class="card card-default">
            <div class="card-body">
                <div class="form-group row">
                    <div class="col-md-3"><nop-label asp-for="Enabled" /></div>
                    <div class="col-md-9"><nop-editor asp-for="Enabled" /></div>
                </div>
                <div class="form-group row">
                    <div class="col-md-9 offset-md-3">
                        <button type="submit" name="test-connection" class="btn bg-blue">
                            @T("Plugins.Misc.Alanube.TestConnection")
                        </button>
                    </div>
                </div>
                @if (Model.TestConnectionSucceeded.HasValue)
                {
                    <div class="form-group row">
                        <div class="col-md-9 offset-md-3">
                            <div class="alert @(Model.TestConnectionSucceeded.Value ? "alert-success" : "alert-danger")">
                                <strong>@T("Plugins.Misc.Alanube.TestConnection.Result")</strong><br />
                                @Model.TestConnectionMessage<br />
                                @T("Plugins.Misc.Alanube.TestConnection.Environment"): @Model.TestConnectionEnvironment<br />
                                @if (Model.TestConnectionStatusCode.HasValue)
                                {
                                    @T("Plugins.Misc.Alanube.TestConnection.Status"): @Model.TestConnectionStatusCode<br />
                                }
                                @if (!string.IsNullOrWhiteSpace(Model.TestConnectionErrorCode))
                                {
                                    @T("Plugins.Misc.Alanube.TestConnection.ErrorCode"): @Model.TestConnectionErrorCode
                                }
                            </div>
                        </div>
                    </div>
                }
                <div class="form-group row"><div class="col-md-3"><nop-label asp-for="CompanyId" /></div><div class="col-md-9"><select asp-for="CompanyId" class="form-control"><option value="">@T("Plugins.Misc.Alanube.SelectCompany")</option>@foreach (var company in Model.Companies){<option value="@company.Id">@company.TradeName (@company.Ruc)</option>}</select></div></div>
                <div class="form-group row"><div class="col-md-3"><nop-label asp-for="OfficeId" /></div><div class="col-md-9"><select asp-for="OfficeId" class="form-control"><option value="">@T("Plugins.Misc.Alanube.SelectOffice")</option>@foreach (var office in Model.Offices){<option value="@office.Id">@office.Code - @office.Address</option>}</select></div></div>
                <div class="form-group row">
                    <div class="col-md-3"><nop-label asp-for="Environment" /></div>
                    <div class="col-md-9">
                        <nop-select asp-for="Environment" asp-items="Html.GetEnumSelectList<Nop.Plugin.Misc.Alanube.Configuration.AlanubeEnvironment>()" />
                        <span asp-validation-for="Environment"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3"><nop-label asp-for="SandboxApiToken" /></div>
                    <div class="col-md-9">
                        <nop-editor asp-for="SandboxApiToken" html-attributes="@(new { autocomplete = "new-password" })" />
                        <span asp-validation-for="SandboxApiToken"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-3"><nop-label asp-for="ProductionApiToken" /></div>
                    <div class="col-md-9">
                        <nop-editor asp-for="ProductionApiToken" html-attributes="@(new { autocomplete = "new-password" })" />
                        <span asp-validation-for="ProductionApiToken"></span>
                    </div>
                </div>
                <div class="form-group row">
                    <div class="col-md-9 offset-md-3">
                        <button type="submit" class="btn btn-primary">@T("Admin.Common.Save")</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>
