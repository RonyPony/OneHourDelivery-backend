@model Nop.Plugin.Misc.Alanube.Models.OfficesModel
@{ Layout = "_ConfigurePlugin"; }
<div class="content-header clearfix"><h1 class="float-left">@T("Plugins.Misc.Alanube.AdminMenu.Offices")</h1></div>
<form method="get" asp-controller="AlanubeAdmin" asp-action="Offices"><div class="form-group row"><div class="col-md-3"><label class="col-form-label">@T("Plugins.Misc.Alanube.Offices.Company")</label></div><div class="col-md-6"><select name="companyId" class="form-control"><option value="">@T("Plugins.Misc.Alanube.Offices.SelectCompany")</option>@foreach (var company in Model.Companies){<option value="@company.Id" selected="@(company.Id == Model.CompanyId)">@company.TradeName (@company.Ruc)</option>}</select></div><div class="col-md-3"><button class="btn btn-primary" type="submit">@T("Admin.Common.Search")</button></div></div></form>
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)){<div class="alert alert-danger">@Model.ErrorMessage</div>}
@if (!string.IsNullOrWhiteSpace(Model.CompanyId)){<div class="content-header clearfix"><div class="float-right"><a asp-controller="AlanubeAdmin" asp-action="CreateOffice" asp-route-companyId="@Model.CompanyId" class="btn btn-primary">@T("Admin.Common.AddNewRecord")</a></div></div><div class="card card-default"><div class="card-body"><table class="table table-hover table-bordered"><thead><tr><th>ID</th><th>Code</th><th>Address</th><th>Telephone</th><th>Location</th><th></th></tr></thead><tbody>@foreach (var office in Model.Offices){<tr><td>@office.Id</td><td>@office.Code</td><td>@office.Address</td><td>@office.Telephone</td><td>@office.Location</td><td><a asp-controller="AlanubeAdmin" asp-action="EditOffice" asp-route-companyId="@Model.CompanyId" asp-route-id="@office.Id">@T("Admin.Common.Edit")</a></td></tr>}</tbody></table></div></div>}
