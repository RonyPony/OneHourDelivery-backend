@model Nop.Plugin.Misc.Alanube.Models.ProductMappingModel
@{ Layout = "_ConfigurePlugin"; }
<div class="content-header clearfix"><h1>Alanube fiscal configuration for product @Model.ProductId</h1></div>
<form method="post"><input type="hidden" asp-for="ProductId" /><div asp-validation-summary="All" class="text-danger"></div>
<div class="form-group row"><label class="col-md-3 col-form-label">Goods/services (CPBS)</label><div class="col-md-9"><select asp-for="GoodsServiceCode" class="form-control"><option value="">Select a code</option>@foreach (var item in Model.GoodsServices){<option value="@item.Code">@item.Code - @item.Description</option>}</select></div></div>
<div class="form-group row"><label class="col-md-3 col-form-label">Measurement unit</label><div class="col-md-9"><select asp-for="MeasurementUnitCode" class="form-control"><option value="">Select a unit</option>@foreach (var item in Model.MeasurementUnits){<option value="@item.Code">@item.Code - @item.Description</option>}</select></div></div>
<div class="form-group row"><label class="col-md-3 col-form-label">Tax code</label><div class="col-md-9"><input asp-for="TaxCode" class="form-control" /></div></div>
<div class="form-group row"><label class="col-md-3 col-form-label">Description override</label><div class="col-md-9"><input asp-for="DescriptionOverride" class="form-control" /></div></div>
<button type="submit" class="btn btn-primary">Save</button></form>
