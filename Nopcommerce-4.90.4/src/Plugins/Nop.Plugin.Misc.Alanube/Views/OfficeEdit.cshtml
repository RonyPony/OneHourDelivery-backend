@model Nop.Plugin.Misc.Alanube.Models.OfficeEditModel
@{ Layout = "_ConfigurePlugin"; var isEdit = !string.IsNullOrWhiteSpace(Model.Id); }
<div class="content-header clearfix"><h1>@(isEdit ? T("Admin.Common.Edit") : T("Admin.Common.AddNewRecord"))</h1></div>
<form asp-controller="AlanubeAdmin" asp-action="@(isEdit ? "EditOffice" : "CreateOffice")" method="post"><input asp-for="Id" type="hidden" /><input asp-for="CompanyId" type="hidden" /><div class="card card-default"><div class="card-body"><div asp-validation-summary="All"></div><div class="form-group row"><div class="col-md-3"><nop-label asp-for="Type" /></div><div class="col-md-9"><select asp-for="Type" class="form-control"><option value="associated">associated</option><option value="main">main</option></select></div></div><div class="form-group row"><div class="col-md-3"><nop-label asp-for="Email" /></div><div class="col-md-9"><nop-editor asp-for="Email" /></div></div><div class="form-group row"><div class="col-md-3"><nop-label asp-for="Code" /></div><div class="col-md-9"><nop-editor asp-for="Code" /></div></div><div class="form-group row"><div class="col-md-3"><nop-label asp-for="Coordinates" /></div><div class="col-md-9"><nop-editor asp-for="Coordinates" /></div></div><div class="form-group row"><div class="col-md-3"><nop-label asp-for="Address" /></div><div class="col-md-9"><nop-editor asp-for="Address" /></div></div><div class="form-group row"><div class="col-md-3"><nop-label asp-for="Telephone" /></div><div class="col-md-9"><nop-editor asp-for="Telephone" /></div></div><div class="form-group row"><div class="col-md-3"><nop-label asp-for="Location" /></div><div class="col-md-9"><nop-editor asp-for="Location" /></div></div><button type="submit" class="btn btn-primary">@T("Admin.Common.Save")</button></div></div></form>
